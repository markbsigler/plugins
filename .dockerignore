# Keep build context small and avoid leaking local state into images.
.git/
.github/
.venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
.ruff_cache/
.pytest_cache/
.ty_cache/
.mypy_cache/
.inline-snapshot/
**/tests/
docs/
*.md
!my-plugin/servers/*/README.md
.pre-commit-config.yaml
justfile
trivy.yaml
.trivyignore
